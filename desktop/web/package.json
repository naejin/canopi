{
  "name": "canopi-web",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc && vite build",
    "build:web": "tsc && vite build --mode web && node scripts/check-web-build-boundaries.mjs",
    "build:web:root": "CANOPI_WEB_BASE_PATH=/ npm run build:web",
    "package:web": "npm run build:web && node scripts/package-web-edition.mjs",
    "package:web:root": "CANOPI_WEB_BASE_PATH=/ npm run package:web",
    "generate:web-catalog": "cd ../.. && python3 scripts/generate-web-catalog.py",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:types": "cargo run -p bindings-gen",
    "check:web-catalog-artifact": "cd ../.. && python3 scripts/web_catalog_artifact_contract.py check",
    "check:types": "cargo run -p bindings-gen -- --check",
    "prepare": "cd ../.. && husky desktop/web/.husky",
    "prepare:pdf-fonts": "node scripts/prepare-pdf-fonts.mjs",
    "predev": "npm run prepare:pdf-fonts",
    "prebuild": "npm run prepare:pdf-fonts",
    "prebuild:web": "npm run prepare:pdf-fonts",
    "pretest": "npm run prepare:pdf-fonts",
    "build:pdf-validation": "npm run prepare:pdf-fonts && tsc -p scripts/pdf-validation/tsconfig.json && vite build --config scripts/pdf-validation/vite.config.mjs && node scripts/pdf-validation/copy-fonts.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@preact/signals": "^2.0.0",
    "@tanstack/virtual-core": "^3.13.23",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "fontkit": "2.0.4",
    "i18next": "^24.0.0",
    "maplibre-contour": "^0.1.0",
    "maplibre-gl": "^5.21.1",
    "pdfkit": "0.20.2",
    "pixi.js": "^8.17.1",
    "preact": "^10.25.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.1"
  }
}
